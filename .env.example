NODE_ENV=production
PORT=3000
DATA_DIR=/app/data
CHECK_INTERVAL=60000
CHECK_CONCURRENCY=10
CHECK_TIMEOUT=10000
ADMIN_USER=admin
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
# Use a long unique password (12+ characters)
ADMIN_PASSWORD=replace-this-with-a-long-password
# Set false only for local HTTP testing; keep true when served over HTTPS.
COOKIE_SECURE=true

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional SMTP email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=