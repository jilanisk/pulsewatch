{
  "name": "pulsewatch",
  "version": "2.0.0",
  "private": true,
  "description": "Self-hosted website uptime monitoring",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.1.0",
    "ipaddr.js": "^2.2.0",
    "nodemailer": "^7.0.13"
  }
}
